RewriteEngine On
# Options All -Indexes

# ROUTER URL Rewrite
RewriteCond %{SCRIPT_FILENAME} !-f
RewriteCond %{SCRIPT_FILENAME} !-d
RewriteRule ^(.*)$ index.php?route=/$1 [L,QSA]

<IfModule php_module>
    php_value upload_max_filesize 4M
    php_value post_max_size 44M
    php_value max_file_uploads 20
</IfModule>

